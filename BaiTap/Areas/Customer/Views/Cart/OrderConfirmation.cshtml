@model BaiTap.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
}

<h2>Đặt hàng thành công</h2>

<p><strong>Mã đơn hàng:</strong> @Model.orderId</p>
<p><strong>Ngày đặt:</strong> @(Model.orderDate?.ToString("dd/MM/yyyy HH:mm") ?? "Không có dữ liệu")</p>
<p><strong>Địa chỉ nhận hàng:</strong> @Model.User.address</p>
<p><strong>Số điện thoại:</strong> @Model.User.phoneNumber</p>
<p><strong>Tổng tiền:</strong> @Model.totalAmount VNĐ</p>

<h3>Chi tiết đơn hàng</h3>
<table class="table">
    <thead>
        <tr>
            <th>Sản phẩm</th>
            <th>Số lượng</th>
            <th>Giá</th>
            <th>Tổng</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderDetails)
        {
            <tr>
                <td>@item.Product.productName</td>
                <td>@item.quantity</td>
                <td>@item.price</td>
                <td>@(item.quantity * item.price)</td>
            </tr>
        }
    </tbody>
</table>
@if (Model.status != "Paid")
{
    <button class="btn btn-primary pay-momo" data-order-id="@Model.orderId">Thanh toán MOMO</button>
}
<a href="@Url.Action("Index", "Home")" class="btn btn-primary">Về trang chủ</a>

<!-- Modal hiển thị QR code -->
<div class="modal fade" id="momoModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thanh toán bằng MOMO</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body text-center">
                <p>Quét mã QR bằng ứng dụng MOMO để thanh toán</p>
                <div id="qrcode"></div>
                <div class="mt-3">
                    <a id="openMomo" href="#" class="btn btn-primary" target="_blank">Mở ứng dụng MOMO</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        function confirmDelete() {
            return confirm("Bạn có chắc muốn huỷ đơn hàng này?");
        }

        $(document).ready(function () {
            $('.pay-momo').click(function () {
                var orderId = $(this).data('order-id');

                $.ajax({
                    url: '@Url.Action("PayWithMomo")',
                    type: 'POST',
                    data: { orderId: orderId },
                    success: function (response) {
                        if (response.success) {
                            // Tạo QR code
                            $('#qrcode').empty();
                            new QRCode(document.getElementById("qrcode"), response.paymentUrl);

                            // Cập nhật link mở app
                            $('#openMomo').attr('href', response.paymentUrl);

                            // Hiển thị modal
                            $('#momoModal').modal('show');
                        } else {
                            alert('Có lỗi xảy ra: ' + response.message);
                        }
                    },
                    error: function () {
                        alert('Có lỗi xảy ra khi kết nối với server');
                    }

                });
            });
        });
    </script>
}