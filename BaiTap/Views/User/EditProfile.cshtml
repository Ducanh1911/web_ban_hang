﻿@model BaiTap.Models.User
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Chỉnh sửa thông tin";
}

<style>
    body {
        font-size: 20px;
    }

    h2 {
        font-size: 2.2rem;
        font-weight: bold;
    }

    .profile-section {
        background-color: #f8f9fa;
        padding: 40px 60px;
        border-radius: 10px;
    }

    label {
        font-weight: 600;
    }

    .form-control {
        font-size: 1.2rem;
        padding: 12px;
        height: 50px;
    }
</style>

<div class="container-fluid mt-5">
    <div class="profile-section">
        <h2 class="mb-4">Chỉnh sửa thông tin cá nhân</h2>

        @using (Html.BeginForm("EditProfile", "User", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.userId)

            <div class="mb-3">
                <label>Họ tên</label>
                @Html.TextBoxFor(m => m.fullName, new { @class = "form-control" })
            </div>

            <div class="mb-3">
                <label>Số điện thoại</label>
                @Html.TextBoxFor(m => m.phoneNumber, new { @class = "form-control" })
            </div>

            <div class="mb-3">
                <label>Địa chỉ</label>
                @Html.TextBoxFor(m => m.address, new { @class = "form-control" })
            </div>


            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            <a href="~/User/Profile" class="btn btn-secondary ms-2">Hủy</a>
        }
    </div>
</div>