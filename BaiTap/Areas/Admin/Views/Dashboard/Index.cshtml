@model List<BaiTap.Models.Product>

@{
    Layout = "~/Areas/Admin/Views/Shared/Admin_Layout.cshtml";
}
@*<a href="~/Areas/Admin/Views/Shared/Admin_Layout.cshtml">~/Areas/Admin/Views/Shared/Admin_Layout.cshtml</a>*@

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        .main-container {
            padding: 20px;
        }

        .dashboard-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 10px;
            padding: 20px;
            text-align: center;
            box-shadow: 0 0 10px rgba(0,0,0,0.05);
        }

            .stat-card h3 {
                font-size: 18px;
                margin-bottom: 10px;
                color: #333;
            }

            .stat-card .value {
                font-size: 24px;
                font-weight: bold;
                color: #007bff;
            }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .product-card {
            border: 1px solid #ddd;
            border-radius: 10px;
            background: #fff;
            overflow: hidden;
            box-shadow: 0 0 10px rgba(0,0,0,0.05);
            text-align: center;
            padding: 10px;
        }

            .product-card img {
                width: 100%;
                height: 150px;
                object-fit: cover;
                border-radius: 5px;
            }

        .product-name {
            font-size: 16px;
            font-weight: 600;
            margin: 10px 0;
        }

        .price {
            margin-bottom: 10px;
            color: #e60000;
            font-weight: bold;
        }

        .btn-action {
            font-size: 14px;
            margin: 5px;
        }

        .action-buttons {
            display: flex;
            justify-content: center;
            gap: 10px;
        }

        .add-product-btn {
            margin-bottom: 20px;
        }
    </style>
}

<div class="main-container">
    <!-- Dashboard Stats -->
    <div class="dashboard-stats">
        <div class="stat-card">
            <h3>Tổng Sản Phẩm</h3>
            <div class="value">@ViewBag.TotalProducts</div>
        </div>
        <div class="stat-card">
            <h3>Sản Phẩm Hết Hàng</h3>
            <div class="value">@ViewBag.OutOfStockProducts</div>
        </div>
        <div class="stat-card">
            <h3>Tổng Doanh Thu</h3>
            <div class="value">@String.Format("{0:N0}", ViewBag.TotalRevenue).Replace(",", ".") VND</div>
            @*<div class="value">Số đơn hàng: @ViewBag.OrderCount</div>*@
        </div>
    </div>


</div>
<div style="margin: 40px 0;">
    <h3>Biểu Đồ loại sản phẩm</h3>
    <canvas id="categoryChart" height="100"></canvas>
</div>
@section Scripts {
    <!-- Thêm thư viện Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (function () {
            var ctx = document.getElementById("categoryChart");
            if (ctx) {
                var myChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(Json.Encode(ViewBag.CategoryLabels)), // Mã hóa JSON đúng cách
                        datasets: [{
                            label: 'Số lượng sản phẩm',
                            data: @Html.Raw(Json.Encode(ViewBag.CategoryData)), // Mã hóa JSON đúng cách
                            backgroundColor: '#007bff', // Màu xanh dương giống cũ
                            borderColor: '#007bff', // Màu viền giống cũ
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            y: {
                                beginAtZero: true,
                                title: {
                                    display: true,
                                    text: 'Số lượng sản phẩm'
                                }
                            },
                            x: {
                                title: {
                                    display: true,
                                    text: 'Danh mục'
                                }
                            }
                        },
                        plugins: {
                            legend: {
                                display: true,
                                position: 'top'
                            },
                            title: {
                                display: true,
                                text: 'Số lượng sản phẩm theo danh mục',
                                font: {
                                    size: 18
                                }
                            }
                        }
                    }
                });
            } else {
                console.error("Canvas element 'categoryChart' not found!");
            }
        })();
    </script>
}
