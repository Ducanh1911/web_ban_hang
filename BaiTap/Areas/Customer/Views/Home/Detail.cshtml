﻿@model BaiTap.Models.Product
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<a href="@Url.Action("Index", "Home")" class="btn btn-primary">Quay lại</a>
<div class="product-detail">
    <img src="@Url.Content(Model.imageUrl)" alt="@Model.productName" class="product-detail-image">
    <div class="product-detail-info">
        <h2>@Model.productName</h2>
        <p class="price">
            @if (Model.discount > 0)
            {
                <span class="original-price">
                    @String.Format("{0:N0}", Model.price).Replace(",", ".")
                </span>
                <span class="discounted-price">@($"{((decimal)Model.price - (decimal)Model.discount).ToString("#,0").Replace(",", ".")}")</span>

            }
            else
            {
                <span>@($"{Model.price:C}")</span>
            }
        </p>

        <p>@Model.description</p>
        <p><strong>Kho:</strong> @Model.stock sản phẩm</p>
        <h5>Đánh giá sản phẩm</h5>
        @{
            var averageRating = Model.Reviews != null && Model.Reviews.Any()
                ? (double)Model.Reviews.Average(r => r.rating)
                : 0;
        }
        <p>
            @for (int i = 1; i <= 5; i++)
            {
                if (i <= Math.Floor(averageRating))
                {
                    <i class="fas fa-star" style="color: gold;"></i> 
                }
                else if (i - 1 < averageRating)
                {
                    <i class="fas fa-star-half-alt" style="color: gold;"></i> 
                }
                else
                {
                    <i class="far fa-star" style="color: gold;"></i> 
                }
            }
            <span>(@averageRating.ToString("0.0")/5)</span>
        </p>


    </div>
</div>

<style>
    .product-detail {
        display: flex;
        gap: 20px;
        padding: 20px;
    }

    .product-detail-image {
        width: 300px;
        height: auto;
    }

    .product-detail-info {
        max-width: 500px;
    }

    .price {
        font-size: 18px;
        font-weight: bold;
        color: #ff6600;
    }

    .original-price {
        text-decoration: line-through;
        color: #999;
    }

    .discounted-price {
        color: #e60000;
        font-weight: bold;
    }

    .btn {
        display: inline-block;
        padding: 10px 15px;
        margin-top: 10px;
        text-decoration: none;
        color: #fff;
        background: #007bff;
        border-radius: 5px;
    }

        .btn:hover {
            background: #0056b3;
        }
</style>
