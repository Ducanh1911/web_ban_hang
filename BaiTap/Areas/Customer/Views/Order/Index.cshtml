@model IEnumerable<BaiTap.Models.Order>

@{
    ViewBag.Title = "Đơn hàng của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="page-title text-center">Chi tiết đơn hàng</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<!-- Bảng đơn hàng -->
<div class="order-table-container">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Mã đơn hàng</th>
                <th>Tổng tiền</th>
                <th>Trạng thái</th>
                <th>Ngày đặt đơn</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.orderId)</td>
                    <td>@String.Format("{0:N0}", item.finalAmount).Replace(",", ".")</td>
                    <td>@Html.DisplayFor(modelItem => item.status)</td>
                    <td>@Html.DisplayFor(modelItem => item.orderDate)</td>
                    <td>
                        @if (item.status == "Pending")
                        {
                            <a href="@Url.Action("PayWithMomo", new { orderId = item.orderId })" class="btn btn-primary">Thanh toán MOMO</a>
                        }
                        @if (item.status != "Shipped")
                        {
                            @Html.ActionLink("Huỷ đơn hàng", "Delete", new { id = item.orderId }, new { @class = "btn btn-danger", onclick = "return confirmDelete();" })
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section scripts {
    <script>
        function confirmDelete() {
            return confirm("Bạn có chắc muốn huỷ đơn hàng này?");
        }
    </script>
}

<style>
    .page-title {
        font-size: 2rem;
        font-weight: bold;
        color: #333;
        margin-bottom: 20px;
    }

    .order-table-container {
        display: flex;
        justify-content: center;
        margin-top: 20px;
        padding: 0 20px;
    }

    table {
        width: 100%;
        max-width: 1200px;
        border-collapse: collapse;
    }

    th, td {
        text-align: center;
        padding: 12px;
        font-size: 15px;
    }

    th {
        background-color: #f8f9fa;
        color: #495057;
    }

    tr:nth-child(even) {
        background-color: #f2f2f2;
    }

    .btn {
        font-size: 1rem;
        padding: 8px 12px;
        cursor: pointer;
        border-radius: 5px;
        border: none;
    }

    .btn-primary {
        background-color: #007bff;
        color: white;
    }

        .btn-primary:hover {
            background-color: #0056b3;
        }

    .btn-danger {
        background-color: #e74c3c;
        color: white;
    }

        .btn-danger:hover {
            background-color: #c0392b;
        }
</style>