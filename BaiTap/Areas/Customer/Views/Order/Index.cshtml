@model IEnumerable<BaiTap.Models.Order>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>


<table class="table">
    <tr>
        <th>
            Mã đơn hàng
        </th>
        <th>
            Tổng tiền
        </th>
        <th>
            @Html.DisplayNameFor(model => model.status)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.orderDate)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.orderId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.finalAmount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.orderDate)
            </td>
            <td>
                @Html.ActionLink("Delete", "Delete", new { id = item.orderId }, new { onclick = "return confirmDelete(" + item.orderId + ");" })
            </td>
        </tr>
    }

</table>

<script>

    function confirmDelete(url) {
        if (confirm("Bạn muốn xoá sản phẩm này?")) {
            window.location.href = url;
        }
        else {
            return false;
        }
    }
</script>