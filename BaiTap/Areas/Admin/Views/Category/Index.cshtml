@model IEnumerable<BaiTap.Models.Category>

@{
    Layout = "~/Areas/Admin/Views/Shared/Admin_Layout.cshtml";
}

<p>
    @Html.ActionLink("Thêm mới", "Create", "Category", null, new { @class = "btn btn-primary" })
</p>

<table class="table">
    <tr>
        <th>
            Tên danh mục
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.categoryName)
            </td>
            <td>
                @using (Html.BeginForm("Delete", "Category", FormMethod.Post, new { onsubmit = "return confirm('Bạn muốn xoá sản phẩm này?');" }))
                {
                    @Html.Hidden("id", item.categoryId)
                    <input type="submit" value="Delete" class="btn btn-danger btn-sm" />
                }

            </td>
        </tr>
    }
</table>

<script>
    function confirmDelete(url) {
        if (confirm("Bạn muốn xoá sản phẩm này?")) {
            window.location.href = url;
            return true;
        }
        return false; 
    }
</script>
