@model  List<BaiTap.Models.Cart>
@{
    ViewBag.Title = "Giỏ Hàng";
}

<h2>Giỏ hàng của bạn</h2>
<a href="@Url.Action("Index", "Home")" class="btn btn-primary">Quay lại</a>
<a href="@Url.Action("Index", "Order")" class="btn btn-primary">Đơn hàng đã mua</a>
<table class="table">
    <thead>
        <tr>
            <th>STT</th>
            <th>Tên sản phẩm</th>
            <th>Hình ảnh</th>
            <th>Giá</th>
            <th>Số lượng</th>
            <th>Tổng tiền</th>
            <th>Action</th>
            <th></th>

        </tr>
    </thead>
    <tbody>
        @{ int stt = 1; }

        @foreach (var item in Model)
        {
            <tr>
                <td>@stt</td>
                <td>@item.Product.productName</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.Product.imageUrl))
                    {
                        <img src="@Url.Content(item.Product.imageUrl)" alt="Image" style="width: 100px; height: auto;" />
                    }
                    else
                    {
                        <span>No image</span>
                    }
                </td>
                <td>@item.Product.price.ToString("#,0").Replace(",", ".")</td>
                <td>
                    <form action="@Url.Action("UpdateQuantity", "Cart")" method="post" style="display: inline;">
                        <input type="hidden" name="productId" value="@item.productId" />
                        <input type="hidden" name="change" value="-1" />
                        <button type="submit">-</button>
                    </form>

                    <span>@item.quantity</span>

                    <form action="@Url.Action("UpdateQuantity", "Cart")" method="post" style="display: inline;">
                        <input type="hidden" name="productId" value="@item.productId" />
                        <input type="hidden" name="change" value="1" />
                        <button type="submit">+</button>
                    </form>
                </td>
                <td id="total-@item.productId">
                    @(((decimal)item.quantity * (decimal)item.Product.price).ToString("#,0").Replace(",", "."))
                </td>


                <td>
                    <form action="@Url.Action("RemoveCart", "Cart")" method="post" onsubmit="return confirmDelete(@item.productId);">
                        <input type="hidden" name="productId" value="@item.productId" />
                        <button type="submit">Delete</button>
                    </form>
                </td>
                <td>
                    <input type="checkbox" name="selectedProducts" value="@item.Product.productId" />
                    <label for="selectedProducts"></label>
                </td>
            </tr>
            stt++;
        }
    </tbody>
</table>

<h4>Tổng tiền: <span id="totalAmount">0</span> VNĐ</h4>
<form id="checkoutForm" action="@Url.Action("Checkout", "Cart")" method="post">
    <input type="hidden" name="selectedProductIds" id="selectedProductIds" value="" />
    <button type="button" class="btn btn-primary" onclick="submitCheckout()">Mua ngay</button>
</form>


<script>
    function updateTotal() {
        let total = 0;
        document.querySelectorAll('input[name="selectedProducts"]:checked').forEach(checkbox => {
            let productId = checkbox.value;
            let totalPrice = document.getElementById("total-" + productId).innerText.replace(/\./g, '');
            total += parseInt(totalPrice);

        });
        document.getElementById("totalAmount").innerText = total.toLocaleString();
    }

    document.querySelectorAll('input[name="selectedProducts"]').forEach(checkbox => {
        checkbox.addEventListener("change", updateTotal);
    });

    function submitCheckout() {
        let selectedProducts = [];
        document.querySelectorAll('input[name="selectedProducts"]:checked').forEach(checkbox => {
            selectedProducts.push(checkbox.value);
        });

        if (selectedProducts.length === 0) {
            alert("Chọn ít nhất 1 sản phẩm");
            return;
        }
        let confirmCheckout = confirm("Xác nhận mua các sản phẩm này");
        if (confirmCheckout) {
            document.getElementById("selectedProductIds").value = selectedProducts.join(",");
            document.getElementById("checkoutForm").submit();
        } else {
            return;
        }
    }
    function confirmDelete(url) {
        if (confirm("Xoá sản phẩm này khỏi giỏ hàng")) {
            window.location.href = url;
            return true;
        }
        else {
            return false;
        }
    }

</script>
