@model IEnumerable<BaiTap.Models.Order>

@{
    ViewBag.Title = "Index";
}

<a href="@Url.Action("Index", "Home")" class="btn btn-primary">Quay lại</a>


<table class="table">
    <tr>
        <th>
            Mã đơn hàng
        </th>
        <th>
            Tổng tiền
        </th>
        <th>
            Trạng thái
        </th>
        <th>
            Ngày đặt đơn
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.orderId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.finalAmount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.orderDate)
            </td>
            <td>
                <a href="" class="btn btn-primary">Thanh toán</a>
                @Html.ActionLink("Huỷ đơn hàng", "Delete", new { id = item.orderId }, new { @class = "btn btn-primary", onclick = "return confirmDelete(" + item.orderId + ");" })
            </td>
        </tr>
    }

</table>

<script>

    function confirmDelete(url) {
        if (confirm("Bạn muốn xoá sản phẩm này?")) {
            window.location.href = url;
        }
        else {
            return false;
        }
    }
</script>